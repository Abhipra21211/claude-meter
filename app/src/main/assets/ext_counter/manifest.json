{
  "manifest_version": 2,
  "name": "Claude Counter (she-llac)",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "counter@claudemeter.local" } },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shim.js", "counter.user.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
